# Copy this file to .env and fill in your values:   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ============================================================
# THE TOGGLE:  local | cloud
#   local -> only GOOGLE_API_KEY is needed. Vectors in Chroma (.insurance_iq/chroma),
#            uploaded PDFs in .insurance_iq/uploads. No Google Cloud project at all.
#   cloud -> Vertex AI Vector Search + Cloud Storage. Fill in the CLOUD block below.
# ============================================================
APP_MODE=local
ENVIRONMENT=local

# LLM provider: openai (default) | gemini
LLM_PROVIDER=openai

# OpenAI API key (https://platform.openai.com/api-keys) - needed when LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# Gemini API key (https://aistudio.google.com/apikey) - needed when LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key

# Optional. Defaults: openai -> gpt-4o-mini / text-embedding-3-small
#                     gemini -> gemini-3.8-flash / gemini-embedding-001
# LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
# OpenAI only: Responses API (default true; needed for reasoning models + tools) and optional reasoning effort
# OPENAI_USE_RESPONSES_API=true
# OPENAI_REASONING_EFFORT=low
# OPENAI_TEMPERATURE=0.0   # only for non-reasoning models (gpt-4o etc.); reasoning models reject it
# LOCAL_EMBEDDING_MODEL_NAME=text-embedding-3-small
# NOTE: changing provider changes embeddings - re-index your documents.
# LOCAL_DATA_DIR=./.insurance_iq

# Optional: path of the Cardinal Ridge insurance database (default backend/data/cardinal_ridge.db)
# INSURANCE_DB_PATH=./backend/data/cardinal_ridge.db

# Agent middleware guard-rails (optional, these are the defaults)
# AGENT_MAX_MODEL_CALLS=8
# AGENT_MAX_TOOL_CALLS=6
# AGENT_MAX_RETRIES=2

# ============================================================
# CLOUD block - only read when APP_MODE=cloud
# ============================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Path to the service-account key used for Vertex AI + Cloud Storage when running cloud mode from a laptop
GCP_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Cloud Storage bucket (created by the GitHub Action: <project-id>-vector-staging)
GCS_BUCKET_NAME=your-gcp-project-id-vector-staging
GCS_PREFIX=uploads/

# IDs printed at the end of the "Provision Vector Search" step in GitHub Actions
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_INDEX_ENDPOINT_ID=

VERTEX_EMBEDDING_MODEL_NAME=text-embedding-005
